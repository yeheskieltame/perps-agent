# Perps Agent backend — copy to .env and fill. NEVER commit real secrets.
# env=testnet (default) → Bybit testnet + Mantle Sepolia (refuses PERPSAGENT_BYBIT_TESTNET=false).
# env=mainnet           → REAL money on Bybit (requires PERPSAGENT_BYBIT_TESTNET=false).
#   To trade real money on Bybit while keeping on-chain proofs on the FREE Mantle
#   Sepolia chain, also set PERPSAGENT_PROOFS_ON_TESTNET=true and keep the Sepolia
#   RPC + Sepolia contract addresses below. Without that flag, env=mainnet refuses
#   a testnet Mantle RPC.
PERPSAGENT_ENV=testnet
# PERPSAGENT_PROOFS_ON_TESTNET=false

# Bybit v5 (your own keys; capital never leaves Bybit)
PERPSAGENT_BYBIT_API_KEY=
PERPSAGENT_BYBIT_API_SECRET=
PERPSAGENT_BYBIT_TESTNET=true

# Mantle chain + deployed proxy addresses (from contracts/ deploy)
PERPSAGENT_MANTLE_RPC=https://rpc.sepolia.mantle.xyz
PERPSAGENT_MANTLE_PRIVATE_KEY=
PERPSAGENT_STRATEGY_LEDGER_ADDR=
PERPSAGENT_STRATEGY_MEMORY_ADDR=
PERPSAGENT_VAULT_ADDR=
PERPSAGENT_MEMORY_DETAIL_PATH=.perpsagent_memory.json
# iZiSwap (mantle_dex venue) markets, JSON: {"WMNTUSDT":{"base":"0x..","quote":"0x..","base_decimals":18,"quote_decimals":6,"fee":2000}}
PERPSAGENT_IZISWAP_MARKETS=

# Signals / inference (hackathon credits) — next milestone
PERPSAGENT_ELFA_API_KEY=
PERPSAGENT_NANSEN_API_KEY=
PERPSAGENT_SURF_API_KEY=
PERPSAGENT_SURF_BASE_URL=https://api.asksurf.ai/gateway/v1

# Persistence
PERPSAGENT_STORE_DB_PATH=perpsagent.db
# Multi-user worker (Telegram bot): per-user venue keys, Fernet-encrypted at rest.
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored credential unrecoverable. Never commit/log it.
PERPSAGENT_CRED_MASTER_KEY=
# Optional: Postgres for multi-worker deployments (empty = SQLite at STORE_DB_PATH)
PERPSAGENT_POSTGRES_DSN=

# x402 alpha API (pay-per-call settlement)
PERPSAGENT_X402_PAY_TO=
PERPSAGENT_X402_ASSET=
PERPSAGENT_X402_NETWORK=mantle-sepolia
PERPSAGENT_X402_CHAIN_ID=5003
PERPSAGENT_X402_PRICE=10000
PERPSAGENT_X402_FACILITATOR_URL=
PERPSAGENT_ALPHA_PORT=8402
