# Perps Agent Telegram bot — copy to .env and fill. NEVER commit real secrets.
PERPSBOT_TOKEN=                          # bot token from @BotFather
PERPSBOT_API_URL=http://127.0.0.1:9000   # worker (dev) or gateway (prod) base URL
PERPSBOT_ALLOWLIST=                      # comma-separated Telegram user ids; empty = allow all (dev only)
PERPSBOT_DEFAULT_BAND=0.01               # grid half-band fraction when /grid omits it
PERPSBOT_DEFAULT_LEVELS=10
PERPSBOT_DEFAULT_SIZE=0.001
